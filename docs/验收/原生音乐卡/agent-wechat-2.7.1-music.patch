+        let bytes = app_card_request(
+            &state,
+            "offline@chatroom",
+            "music-probe",
+            1234567,
+            &music,
+            3,
+        )
+        .unwrap();
+        let outer = p::decode(&bytes).unwrap();
+        let payload = p::decode(p::data(&outer, 2).unwrap()).unwrap();
+        assert_eq!(p::scalar(&payload, 5).unwrap(), 3);
+        let xml = format!(
+            "<msg>{}</msg>",
+            std::str::from_utf8(p::data(&payload, 6).unwrap()).unwrap()
+        );
+        let doc = roxmltree::Document::parse(&xml).unwrap();
+        let field = |name| {
