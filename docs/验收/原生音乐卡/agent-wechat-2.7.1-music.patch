+#[cfg(test)]
+mod native_music_probe {
+    use super::*;
+
+    #[test]
+    fn accepts_structured_music_and_preserves_normal_share_and_receipt_type() {
+        let body = serde_json::json!({"kind":"music","threadId":"offline@chatroom",
+            "title":"任天堂","author":"G.E.M.邓紫棋","url":"https://example.invalid/song",
+            "musicUrl":"https://example.invalid/synthetic-audio"});
+        let music: ShareSendRequest = serde_json::from_value(body.clone()).unwrap();
+        music.validate().unwrap();
+        assert_eq!(music.subtype(), 3);
+        let xml = format!("<msg>{}</msg>", music.xml("test").unwrap());
+        let document = roxmltree::Document::parse(&xml).unwrap();
+        let app = document
+            .descendants()
+            .find(|n| n.has_tag_name("appmsg"))
+            .unwrap();
+        let card = parse(app, 3).unwrap().card;
+        assert_eq!(card.title.as_deref(), Some("任天堂"));
+        assert_eq!(card.description.as_deref(), Some("G.E.M.邓紫棋"));
+        let mut no_audio = body;
+        no_audio.as_object_mut().unwrap().remove("musicUrl");
+        assert!(serde_json::from_value::<ShareSendRequest>(no_audio).is_err());
+        let link: ShareSendRequest = serde_json::from_value(serde_json::json!({"kind":"share",
+            "threadId":"offline@chatroom","title":"test","url":"https://example.invalid/"}))
+        .unwrap();
+        assert_eq!(link.subtype(), 5);
+    }
+}
