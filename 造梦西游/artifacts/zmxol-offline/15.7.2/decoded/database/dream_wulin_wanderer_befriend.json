{"8185700": {"id": 8185700, "type": 285, "sect_type": 5, "sect_name": "\u9f99\u5e2e\u4e3b", "befriend_conditions_type": 101, "description": "\u6c5f\u6e56\u52a8\u8361\uff0c\u8bf8\u591a\u4e0d\u5e73\u4e4b\u4e8b\u5f85\u89e3\u3002\u8fd9%d\u6b21\u4e0b\u5c71\u5386\u7ec3\uff0c\u5c11\u4fa0\u5982\u8981\u884c\u8d70\u56db\u65b9\uff0c\u60e9\u6cbb\u6076\u5f92\uff0c\u6276\u5371\u6d4e\u56f0\uff0c\u6211\u613f\u52a9\u4f60\u4e00\u81c2\u4e4b\u529b\uff01", "cond": 0, "task_target": 1, "dialogue_text1": "\u597d\uff01\u597d\uff01\u597d\uff01\u671f\u671b\u5c11\u4fa0\u4eca\u540e\u80fd\u5c06\u201c\u4fa0\u4e49\u4e3a\u5148\u201d\u7684\u5b97\u65e8\u4f20\u904d\u6c5f\u6e56\uff0c\u4e0d\u8d1f\u6211\u6240\u6258\uff01", "dialogue_text2": "\u6c5f\u6e56\u9669\u6076\uff0c\u4f60\u5386\u7ec3\u7684\u706b\u5019\u8fd8\u8fdc\u8fdc\u4e0d\u591f\uff01\u518d\u53bb\u5386\u7ec3\u5386\u7ec3\uff0c\u83ab\u8981\u8f9c\u8d1f\u4e86\u6211\u7684\u671f\u5f85\uff01", "dialogue_text3": "\u6765\u5f97\u6b63\u597d\uff01\u4eca\u65e5\u9152\u9986\u5907\u4e86\u4e9b\u597d\u9152\uff0c\u54b1\u4eec\u4e0d\u9189\u4e0d\u5f52\uff01"}, "8185701": {"id": 8185701, "type": 285, "sect_type": 6, "sect_name": "\u7389\u8427\u5c45\u58eb", "befriend_conditions_type": 102, "description": "\u8840\u916c\u5373\u6b66\u6797\u58f0\u671b\uff0c\u672c\u5c45\u58eb\u4e0d\u4e0e\u65e0\u540d\u4e4b\u8f88\u6765\u5f80\uff0c\u7b49\u4f60\u51d1\u8db3%d\u4e2a\u8840\u916c\uff0c\u518d\u6765\u5427\uff01", "cond": 0, "task_target": 100, "dialogue_text1": "\u54fc\uff0c\u5012\u6ca1\u8ba9\u672c\u5c45\u58eb\u5931\u671b\u3002\u8fd9\u8840\u916c\u867d\u4e0d\u7b97\u4ec0\u4e48\uff0c\u4f46\u4f60\u8fd9\u4efd\u80fd\u8010\uff0c\u4e5f\u7b97\u52c9\u5f3a\u5165\u5f97\u672c\u5c45\u58eb\u7684\u773c\u3002", "dialogue_text2": "\u54fc\uff01\u8fde\u8fd9\u70b9\u8840\u916c\u90fd\u62ff\u4e0d\u5230\uff0c\u4e5f\u6562\u5728\u8bf7\u6211\u6307\u6559\uff1f\u901f\u901f\u79bb\u53bb\uff0c\u4ec0\u4e48\u65f6\u5019\u51d1\u9f50\u4e86\uff0c\u518d\u6765\u89c1\u6211\uff01", "dialogue_text3": "\u6b64\u756a\u524d\u6765\uff0c\u53ef\u662f\u627e\u672c\u5c45\u58eb\u63a2\u8ba8\u6b66\u5b66\uff1f\u82e5\u65e0\u4e8b\uff0c\u4fbf\u966a\u672c\u5c45\u58eb\u591a\u996e\u51e0\u676f\u4e5f\u597d\u3002"}, "8185702": {"id": 8185702, "type": 285, "sect_type": 7, "sect_name": "\u9189\u5251\u4ed9\u4eba", "befriend_conditions_type": 103, "description": "\u5567\u5567\uff0c\u8fd9\u9152\u9986\u7684\u9152\u7ec8\u7a76\u8fd8\u662f\u5dee\u4e86\u4e00\u4e9b\u3002\u4e0d\u77e5\u5c0f\u53cb\u662f\u5426\u80fd\u7ed9\u8001\u9053\uff0c\u5728\u4f60\u300c\u5e08\u95e8\u300d\u4e2d\u641e%d\u74f6\u9648\u917f\u5973\u513f\u7ea2\u6765\uff01", "cond": 560813, "task_target": 1, "dialogue_text1": "\u5999\u554a\uff01\u5c0f\u53cb\u679c\u7136\u5b58\u6709\u597d\u9152\uff01\u6765\u3001\u6765\u3001\u6765\uff0c\u4eca\u65e5\u5b9a\u8981\u4e0e\u8001\u9053\u4e0d\u9189\u4e0d\u5f52\uff01", "dialogue_text2": "\u5c0f\u53cb\uff0c\u8fd9\u7f8e\u9152\u8fd8\u6ca1\u51d1\u9f50\u554a\uff01\u4f60\u518d\u53bb\u5bfb\u5bfb\uff0c\u7b49\u51d1\u9f50\u4e86\uff0c\u8001\u9053\u5b9a\u4e0e\u4f60\u4e00\u9189\u65b9\u4f11\uff01", "dialogue_text3": "\u5c0f\u53cb\u6765\u5566\uff01\u5feb\u5feb\u5750\u4e0b\uff0c\u8001\u9053\u65b0\u5f97\u4e86\u4e00\u575b\u4f73\u917f\uff0c\u6b63\u597d\u4e0e\u4f60\u5171\u996e\uff01\u559d\u7740\u9152\uff0c\u518d\u804a\u4e9b\u6c5f\u6e56\u8da3\u4e8b\uff01"}, "8185703": {"id": 8185703, "type": 285, "sect_type": 8, "sect_name": "\u5251\u72c2", "befriend_conditions_type": 104, "description": "\u96d5\u5144\u7684\u6307\u6559\u975e\u5e38\u4e25\u82db\uff0c\u542c\u95fb\u300c\u6b66\u6797\u5927\u4f1a\u300d\u9ad8\u624b\u4e91\u96c6\uff0c\u4f60\u4e14\u53bb\u51fb\u8d25 %d\u4e2a\u6311\u6218\u8005\uff0c\u8bc1\u660e\u81ea\u5df1\u7684\u5b9e\u529b\uff01", "cond": 0, "task_target": 1, "dialogue_text1": "\u597d\u5c0f\u5b50\uff01\u5728\u6b66\u6797\u5927\u4f1a\u4e0a\u8fde\u8d25\u591a\u4f4d\u6311\u6218\u8005\uff0c\u8fd9\u7b49\u98ce\u91c7\uff0c\u5012\u6709\u51e0\u5206\u6211\u5f53\u5e74\u7684\u795e\u97f5\uff01\u4e0d\u8fc7\uff0c\u6c5f\u6e56\u4e4b\u8def\u8fd8\u957f\uff0c\u83ab\u8981\u6b62\u6b65\u4e8e\u6b64\uff01", "dialogue_text2": "\u6b66\u6797\u5927\u4f1a\u4e0a\u8fde\u51fb\u8d25\u8fd9\u70b9\u6311\u6218\u8005\u90fd\u505a\u4e0d\u5230\uff0c\u4f60\u7684\u6b66\u529f\u8fd8\u9700\u7cbe\u8fdb\uff01\u6c5f\u6e56\u4e2d\u9ad8\u624b\u5982\u4e91\uff0c\u82e5\u4e0d\u52aa\u529b\uff0c\u7ec8\u6709\u4e00\u65e5\u4f1a\u53d7\u5236\u4e8e\u4eba\uff01", "dialogue_text3": "\u597d\u4e45\u4e0d\u89c1\uff01\u6700\u8fd1\u6c5f\u6e56\u53c8\u51fa\u4e86\u4e0d\u5c11\u65b0\u9c9c\u4e8b\uff0c\u4ec0\u4e48\u65f6\u5019\u968f\u6211\u53bb\u901b\u901b\uff0c\u8bf4\u4e0d\u5b9a\u80fd\u78b0\u4e0a\u51e0\u4e2a\u6709\u8da3\u7684\u5bf9\u624b\uff0c\u6d3b\u52a8\u6d3b\u52a8\u7b4b\u9aa8\uff01"}, "8185704": {"id": 8185704, "type": 285, "sect_type": 9, "sect_name": "\u59e5\u59e5", "befriend_conditions_type": 105, "description": "\u529f\u529b\u4e0d\u8db3\u4ee5\u51a0\u7edd\u7fa4\u96c4\uff0c\u600e\u80fd\u53d7\u672c\u59e5\u59e5\u6307\u6559\uff1f\u529f\u529b\u8fbe\u5230%d\uff0c\u518d\u6765\u89c1\u6211\uff01", "cond": 0, "task_target": 110000, "dialogue_text1": "\u4e0d\u9519\u4e0d\u9519\uff0c\u529f\u529b\u5f53\u771f\u4e0d\u9519\uff01\u5c71\u4e0a\u6b63\u597d\u7f3a\u4eba\u6574\u6cbb\uff0c\u4f60\u5012\u662f\u503c\u5f97\u4f6c\u4f6c\u6211\u6307\u70b9\u4e00\u4e8c\u3002", "dialogue_text2": "\u529f\u529b\u624d\u8fd9\u70b9\uff1f\u771f\u662f\u4e0d\u582a\uff01\u518d\u56de\u53bb\u82e6\u7ec3\u5427\uff0c\u4e0b\u6b21\u83ab\u8981\u518d\u8ba9\u6211\u5931\u671b\uff01", "dialogue_text3": "\u6765\u4e86\uff1f\u542c\u95fb\u5c71\u4e0a\u8fd1\u65e5\u6709\u4e9b\u7410\u4e8b\uff0c\u4f60\u65e2\u6765\u4e86\uff0c\u6709\u7a7a\u4fbf\u5e2e\u6211\u5904\u7406\u4e00\u4e8c\uff0c\u4e8b\u540e\u5c11\u4e0d\u4e86\u4f60\u7684\u597d\u5904\uff01"}}