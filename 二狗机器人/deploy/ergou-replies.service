[Unit]
Description=Ergou authorized group replies
After=ergou-listener.service
Wants=ergou-listener.service

[Service]
User=ergou
WorkingDirectory=/opt/ergou/current
ExecStart=/usr/bin/python3 -m deploy.group_workers replies
Environment=ERGOU_CREDENTIAL_DIR=/var/lib/ergou/credentials
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=8s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ergou

[Install]
WantedBy=multi-user.target
