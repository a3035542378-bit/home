[Unit]
Description=Ergou WeChat plugin
After=network-online.target
Wants=network-online.target

[Service]
User=ergou
Group=ergou
Environment=HOME=/var/lib/ergou
WorkingDirectory=/var/lib/ergou/wechat
ExecStart=/opt/ergou/bin/wx --data-dir /var/lib/ergou/wechat --listen 127.0.0.1:6174 serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ergou/wechat

[Install]
WantedBy=multi-user.target
