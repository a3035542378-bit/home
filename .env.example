# Copy to .env and fill in your own passwords; URL-encode passwords in URLs.
MYSQL_DATABASE=account_tasks
MYSQL_USER=platform
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=
DOCKER_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
DEPENDENCY_TIMEOUT_SECONDS=3
ENVIRONMENT=development
ADMIN_ACCESS_TOKEN=
ONEBOT_HTTP_URL=
ONEBOT_WS_URL=
ONEBOT_ACCESS_TOKEN=
ONEBOT_TIMEOUT_SECONDS=5
ONEBOT_RETRIES=1
TASK_STREAM_NAME=qq:task:stream
TASK_CONSUMER_GROUP=qq-workers
TASK_DLQ_NAME=qq:task:dlq
TASK_LOCK_PREFIX=task-lock:
WORKER_KEY_PREFIX=worker:
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL=10
WORKER_HEARTBEAT_TTL=60
EXECUTION_LEASE_SECONDS=60
TASK_LOCK_TTL=60
TASK_TIMEOUT_SECONDS=30
WORKER_SHUTDOWN_TIMEOUT=20
MAINTENANCE_INTERVAL=5
OUTBOX_REPUBLISH_SECONDS=30
MAX_AUTO_RETRY=2
AUTO_RETRY_BASE_SECONDS=5
SCHEDULER_ENABLED=true
SCHEDULE_HOUR=1
SCHEDULE_MINUTE=0
BUSINESS_TIMEZONE=Asia/Shanghai

# Phase 6：每个 Node 独立配置地址；secret_ref 引用此映射中的键。
# 不提交真实凭据；default 引用显式使用上面的 ONEBOT_* 全局配置。
ONEBOT_NODE_TOKENS='{}'
ONEBOT_HTTP_TIMEOUT=5
ONEBOT_CONNECT_TIMEOUT=3
ONEBOT_MAX_RETRIES=1
ONEBOT_WS_RECONNECT_MIN_SECONDS=1
ONEBOT_WS_RECONNECT_MAX_SECONDS=30
ONEBOT_WS_HEARTBEAT_TIMEOUT=60
ONEBOT_POLL_INTERVAL=15

# Phase 7：密钥使用 Fernet.generate_key()，禁止提交真实值。
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=5
BROWSER_NAVIGATION_TIMEOUT=15
BROWSER_MAX_CONTEXTS=5
BROWSER_LOCALE=zh-CN
BROWSER_TIMEZONE=Asia/Shanghai
BROWSER_STORAGE_KEY=
WORKER_STOP_GRACE_PERIOD=60s

# QQ Web：真实页面与 Selector 未核验，留空；不填写登录凭据或查询参数。
QQ_WEB_BASE_URL=
QQ_TASK_CENTER_URL=
QQ_ACTIVITY_URL=

# 每个 Operation 独立配置执行器优先级；不会提升验证等级。
EXECUTOR_PRIORITIES={}
